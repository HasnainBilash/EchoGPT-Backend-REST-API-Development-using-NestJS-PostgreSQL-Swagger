# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins, e.g. chrome-extension://<extension-id>,http://localhost:5173
# Empty = allow all origins in development.
CORS_ORIGINS=
# Set to false to hide Swagger UI (e.g. in production)
SWAGGER_ENABLED=true

# ─── Auth (JWT) ──────────────────────────────────────────────────
# Generate strong random secrets, e.g. `openssl rand -hex 32`. Never reuse across environments.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# ─── Secrets encryption ──────────────────────────────────────────
# AES-256-GCM key for AI provider API keys stored in the database: 64 hex chars.
# DEV-ONLY value below — generate your own with `openssl rand -hex 32`.
# Changing it makes already-stored provider keys unreadable (re-enter them).
ENCRYPTION_KEY=6465762d6f6e6c792d6b65792d6368616e67652d6d652d696e2d70726f642121

# ─── Web search ──────────────────────────────────────────────────
# How long search-engine results are cached (seconds). 0 disables the cache.
SEARCH_CACHE_TTL_SECONDS=3600

# ─── Email verification ──────────────────────────────────────────
# Link sent in verification emails (?token=... is appended). Default: this API's
# GET /api/v1/auth/verify-email. Point it at a frontend page if you have one.
EMAIL_VERIFICATION_URL=
# SMTP for sending email. Leave SMTP_HOST empty in development: emails are then
# written to the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EchoGPT <no-reply@echogpt.local>

# ─── First admin (used only by `npm run db:seed`) ────────────────
# Leave empty to skip. An existing user with this email is never modified.
ADMIN_EMAIL=admin@echogpt.local
ADMIN_PASSWORD=Admin12345

# ─── Database ────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public

# ─── Rate limiting (per IP) ──────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
