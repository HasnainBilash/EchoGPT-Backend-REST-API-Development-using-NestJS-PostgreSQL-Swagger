# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins, e.g. chrome-extension://<extension-id>,http://localhost:5173
# Empty = allow all origins in development.
CORS_ORIGINS=
# Set to false to hide Swagger UI (e.g. in production)
SWAGGER_ENABLED=true

# ─── Auth (JWT) ──────────────────────────────────────────────────
# Generate strong random secrets, e.g. `openssl rand -hex 32`. Never reuse across environments.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# ─── Database ────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://echogpt:echogpt@localhost:5432/echogpt?schema=public

# ─── Rate limiting (per IP) ──────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
